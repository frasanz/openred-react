# OpenRed React frontend -- environment variables.
#
# Copy to .env for local development. .env is gitignored.

# Where the dev server proxies API calls (src/setupProxy.js).
# DEFAULT IF UNSET: http://localhost:8020 -- the local stack from the OpenRed
# repository's compose.yaml. It used to default to https://api.open-red.es, i.e.
# production, which meant `npm start` with no configuration read and wrote the
# live service. Set this only when you deliberately want a remote API.
OPENRED_API_PROXY=http://localhost:8020

# PRODUCTION BUILDS ONLY, AND DELIBERATELY LEFT UNSET HERE.
# src/config/api.ts reads it to decide the API's address for `npm run build`.
# Development ignores it completely: there the baseURL is relative and the dev
# server's proxy decides the target, which is OPENRED_API_PROXY above.
#
# Leave it commented out. Create React App reads THIS FILE'S copy, .env, during
# `npm run build` as well as during `npm start`, so a local value here is baked
# into a production bundle -- an .env holding http://localhost:8020 ships a
# production build that calls localhost. Unset, src/config/api.ts falls back to
# https://api.open-red.es, which is what production wants anyway.
#
# To build against a different API, pass it for that build only:
#   REACT_APP_API_URL=https://api.example.org npm run build
# or put it in .env.production.local, which .gitignore already covers.
# REACT_APP_API_URL=

# Mapbox token. REQUIRED FOR THE MAP BASEMAP AND FOR NOTHING ELSE.
# Without it the deck.gl layers still compute and the rest of the app works, but
# the map has no basemap under the points. Any token from a free Mapbox account
# works. The code checks that it starts with "pk." (see check-env.js).
REACT_APP_MAPBOX_TOKEN=

# App info
REACT_APP_NAME=OpenRed
REACT_APP_VERSION=1.0.0

# Dev-server port. 3000 and 3001 are taken by the other Ibercivis frontends on
# a development laptop, so this app takes 3010.
PORT=3010

# Google sign-in. @react-oauth/google's GoogleOAuthProvider is mounted
# unconditionally in src/index.tsx, and LoginPage calls useGoogleLogin as a
# top-level hook, so with this EMPTY the /login page dies on mount with
# "Missing required parameter client_id" thrown from Google's gsi/client --
# taking email/password sign-in down with it, even though that path needs no
# Google at all.
#
# The value below is a correctly-shaped placeholder, not a real client id. It is
# enough for Google's script to initialise, so /login renders and email/password
# works. Clicking "sign in with Google" will fail, and locally it could not work
# anyway: it needs a real OAuth client with http://localhost:3010 registered as an
# authorised origin, which we do not have.
REACT_APP_GOOGLE_CLIENT_ID=000000000000-localdevplaceholder.apps.googleusercontent.com
