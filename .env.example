# OpenRed React frontend -- environment variables.
#
# Copy to .env for local development. .env is gitignored.

# Where the dev server proxies API calls (src/setupProxy.js).
# DEFAULT IF UNSET: http://localhost:8020 -- the local stack from the OpenRed
# repository's compose.yaml. It used to default to https://api.open-red.es, i.e.
# production, which meant `npm start` with no configuration read and wrote the
# live service. Set this only when you deliberately want a remote API.
OPENRED_API_PROXY=http://localhost:8020

# Only used by a PRODUCTION build (`npm run build`). In development
# src/services/api.ts uses a relative baseURL and goes through the proxy above.
REACT_APP_API_URL=http://localhost:8020

# Mapbox token. REQUIRED FOR THE MAP BASEMAP AND FOR NOTHING ELSE.
# Without it the deck.gl layers still compute and the rest of the app works, but
# the map has no basemap under the points. Any token from a free Mapbox account
# works. The code checks that it starts with "pk." (see check-env.js).
REACT_APP_MAPBOX_TOKEN=

# App info
REACT_APP_NAME=OpenRed
REACT_APP_VERSION=1.0.0

# Dev-server port. 3000 and 3001 are taken by the other Ibercivis frontends on
# a development laptop, so this app takes 3010.
PORT=3010
